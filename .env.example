# cp .env.example .env   (never commit .env)
DB_NAME=realtimecollab
DB_USER=realtimecollab
DB_PASSWORD=change-me
# Min 32 chars:  openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=7
# Browser origins allowed to call the API (comma-separated). Add your domain in production.
CORS_ORIGINS=http://localhost:8081
