# Frontend environment variables for RealtimeCollab
#
# Development (default): backend runs on localhost:8080
# For Docker compose development, you may set `VITE_API_URL=http://backend:8080/api`
# For production behind an Nginx reverse proxy that exposes `/api` and `/ws`,
# set `VITE_API_URL=/api` and `VITE_WS_URL=ws://<HOST>/ws` (or use relative paths).

# Base API URL used by the frontend for REST calls
VITE_API_URL=http://localhost:8080/api

# WebSocket URL used by the frontend for STOMP connections
VITE_WS_URL=ws://localhost:8080/ws

# Application display name
VITE_APP_NAME=RealtimeCollab

# Environment name (development | production)
VITE_ENV=development

# Default pagination / page size for lists
VITE_DEFAULT_PAGE_SIZE=20

# Toggle client-side mock data (useful for UI development)
VITE_ENABLE_MOCK=false

# Optional: analytics or feature flags (leave empty if not used)
#VITE_ANALYTICS_ID=

# Notes:
# - Prefix all variables that should be exposed to the browser with VITE_.
# - Do not commit real secrets. Keep JWT secrets and DB credentials on the backend only.
